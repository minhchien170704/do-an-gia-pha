@startuml use-case

title Use Case Diagram - Hệ thống Quản lý Sơ đồ Gia phả

left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}
skinparam rectangle {
    BackgroundColor #F5F5FF
    BorderColor #A80036
}
skinparam ArrowColor #A80036

actor "Người dùng" as User

rectangle "Hệ thống quản lý gia phả" {

    package "Quản lý thành viên" {
        usecase "UC01\nThêm người" as UC01
        usecase "UC02\nSửa thông tin người" as UC02
        usecase "UC03\nXóa người" as UC03
        usecase "UC04\nTìm kiếm người" as UC04
        usecase "UC05\nXem danh sách người" as UC05
        usecase "UC06\nXem chi tiết người" as UC06
    }

    package "Quan hệ phả hệ" {
        usecase "UC07\nGán cha" as UC07
        usecase "UC08\nGán mẹ" as UC08
        usecase "UC09\nGỡ quan hệ cha/mẹ" as UC09
    }

    package "Xem cây gia phả" {
        usecase "UC10\nXem cây gia phả (sơ đồ 2D)" as UC10
        usecase "UC11\nXem tổ tiên" as UC11
        usecase "UC12\nXem hậu duệ" as UC12
    }

    package "Ảnh đại diện" {
        usecase "UC13\nChọn ảnh đại diện" as UC13
    }

    package "Xuất & In ấn" {
        usecase "UC14\nXuất sơ đồ ra file PNG" as UC14
        usecase "UC15\nIn sơ đồ cây gia phả" as UC15
    }
}

' --- Quản lý thành viên ---
User --> UC01
User --> UC02
User --> UC03
User --> UC04
User --> UC05
User --> UC06

' --- Quan hệ phả hệ ---
User --> UC07
User --> UC08
User --> UC09

' --- Xem cây gia phả ---
User --> UC10
User --> UC11
User --> UC12

' --- Ảnh đại diện ---
User --> UC13

' --- Xuất & In ấn ---
User --> UC14
User --> UC15

' --- Quan hệ <<extend>> / <<include>> ---
UC10 ..> UC11 : <<include>>\ntải tổ tiên
UC10 ..> UC12 : <<include>>\ntải hậu duệ

UC02 ..> UC07 : <<extend>>\ngán lại cha
UC02 ..> UC08 : <<extend>>\ngán lại mẹ
UC02 ..> UC09 : <<extend>>\ngỡ quan hệ

UC01 ..> UC13 : <<include>>\nchọn ảnh đại diện
UC02 ..> UC13 : <<include>>\nchọn ảnh đại diện

UC14 ..> UC10 : <<include>>\nchụp sơ đồ
UC15 ..> UC10 : <<include>>\nchụp sơ đồ

note bottom of User
  Người dùng làm việc trên
  ứng dụng JavaFX chạy cục bộ
end note

@enduml
