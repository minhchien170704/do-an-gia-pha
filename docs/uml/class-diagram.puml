@startuml class-diagram

title Class Diagram (Tổng quan) - Hệ thống Quản lý Sơ đồ Gia phả\nChỉ lớp có thật trong src/main/java - không vẽ lớp test\nChi tiết thuộc tính/phương thức: xem 3 sơ đồ tách theo gói

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam class {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}
skinparam package {
    BackgroundColor #F5F5FF
    BorderColor #A80036
    FontSize 12
}
skinparam enum {
    BackgroundColor #FEFECE
    BorderColor #A80036
}
skinparam linetype ortho

' ============================================================
' GÓI: com.giapha.model
' ============================================================
package "com.giapha.model" {
    enum Gender {
        MALE
        FEMALE
        + getDisplayName() : String
        + getBadgeCssClass() : String
    }
    class Person
}

' ============================================================
' GÓI: com.giapha.exception
' ============================================================
package "com.giapha.exception" {
    class SelfParentException {
        <<custom exception>>
    }
    class SameParentException {
        <<custom exception>>
    }
    class InvalidParentGenderException {
        <<custom exception>>
    }
    class CycleDetectedException {
        <<custom exception>>
    }
    class PersonInUseException {
        <<custom exception>>
    }
    class PersonNotFoundException {
        <<custom exception>>
    }
    class InvalidBirthYearException {
        <<custom exception>>
    }
}

' ============================================================
' GÓI: com.giapha.repository
' ============================================================
package "com.giapha.repository" {
    interface PersonRepository {
        <<interface>>
    }
    class JdbcPersonRepository
}

' ============================================================
' GÓI: com.giapha.database
' ============================================================
package "com.giapha.database" {
    class DatabaseConnection {
        <<utility>>
    }
}

' ============================================================
' GÓI: com.giapha.service
' ============================================================
package "com.giapha.service" {
    class FamilyTreeService
}

' ============================================================
' GÓI: com.giapha.controller
' ============================================================
package "com.giapha.controller" {
    class PersonController
}

' ============================================================
' GÓI: com.giapha.view
' ============================================================
package "com.giapha.view" {
    class PeopleListView
    class PersonFormView
    class PersonDetailView
    class FamilyTreeView
    class FamilyTreeDiagram
    class PersonAvatar
}

' ============================================================
' GÓI: com.giapha.util
' ============================================================
package "com.giapha.util" {
    class ImageManager {
        <<utility>>
    }
    class PngWriter {
        <<utility>>
    }
}

' ============================================================
' GÓI: com.giapha (gốc)
' ============================================================
package "com.giapha" {
    class Main
}

' ============================================================
' QUAN HỆ — MODEL
' ============================================================
Person --> "1" Gender : giới tính
Person "0..*" --> "0..1" Person : cha
Person "0..*" --> "0..1" Person : mẹ

' ============================================================
' QUAN HỆ — EXCEPTION (kế thừa RuntimeException)
' ============================================================
SelfParentException --|> RuntimeException
SameParentException --|> RuntimeException
InvalidParentGenderException --|> RuntimeException
CycleDetectedException --|> RuntimeException
PersonInUseException --|> RuntimeException
PersonNotFoundException --|> RuntimeException
InvalidBirthYearException --|> RuntimeException

' ============================================================
' QUAN HỆ — REPOSITORY / DATABASE / SERVICE
' ============================================================
JdbcPersonRepository ..|> PersonRepository : implements
JdbcPersonRepository --> DatabaseConnection : lấy Connection
DatabaseConnection --> "Connection" : tạo (factory)

FamilyTreeService --> PersonRepository : phụ thuộc vào interface (Dependency Inversion)

' ============================================================
' QUAN HỆ — CONTROLLER / SERVICE
' ============================================================
PersonController --> FamilyTreeService : gọi nghiệp vụ
FamilyTreeService ..> SelfParentException : ném
FamilyTreeService ..> SameParentException : ném
FamilyTreeService ..> InvalidParentGenderException : ném
FamilyTreeService ..> CycleDetectedException : ném
FamilyTreeService ..> PersonInUseException : ném
FamilyTreeService ..> PersonNotFoundException : ném
FamilyTreeService ..> InvalidBirthYearException : ném
PersonController ..> SelfParentException : bắt
PersonController ..> SameParentException : bắt
PersonController ..> InvalidParentGenderException : bắt
PersonController ..> CycleDetectedException : bắt
PersonController ..> PersonInUseException : bắt
PersonController ..> PersonNotFoundException : bắt
PersonController ..> InvalidBirthYearException : bắt

' ============================================================
' QUAN HỆ — VIEW / CONTROLLER
' ============================================================
PeopleListView --> PersonController
PersonFormView --> PersonController
PersonDetailView --> PersonController
FamilyTreeView --> PersonController
PersonController --> Person : thành viên đang chọn

' ============================================================
' QUAN HỆ — VIEW ↔ VIEW, VIEW ↔ UTIL
' ============================================================
FamilyTreeView *-- FamilyTreeDiagram : chứa (composition)
FamilyTreeDiagram --> PersonAvatar : dựng node
FamilyTreeDiagram --> Person : dữ liệu hiển thị
PeopleListView --> PersonAvatar : hiển thị avatar
PersonDetailView --> PersonAvatar : hiển thị avatar
PersonFormView --> PersonAvatar : xem trước ảnh
PersonFormView --> ImageManager : kiểm tra định dạng
PersonController --> ImageManager : copy ảnh vào images/
FamilyTreeView --> PngWriter : ghi file PNG

' ============================================================
' QUAN HỆ — COMPOSITION ROOT
' ============================================================
Main --> PersonController : khởi tạo
Main --> PeopleListView
Main --> PersonFormView
Main --> PersonDetailView
Main --> FamilyTreeView

@enduml
