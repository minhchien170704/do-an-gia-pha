@startuml class-diagram

skinparam classAttributeIconSize 0
skinparam classFontSize 13
skinparam class {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}
skinparam linetype ortho

' ============================================================
' ENUM
' ============================================================

enum Gender {
    MALE
    FEMALE
}

' ============================================================
' MODEL
' ============================================================

class Person {
    - id : int
    - fullName : String
    - birthYear : int
    - gender : Gender
    - photoPath : String
    - father : Person
    - mother : Person
    + getId() : int
    + setId(id : int) : void
    + getFullName() : String
    + setFullName(fullName : String) : void
    + getBirthYear() : int
    + setBirthYear(birthYear : int) : void
    + getGender() : Gender
    + setGender(gender : Gender) : void
    + getPhotoPath() : String
    + setPhotoPath(photoPath : String) : void
    + getFather() : Person
    + setFather(father : Person) : void
    + getMother() : Person
    + setMother(mother : Person) : void
}

' ============================================================
' VIEW
' ============================================================

class PeopleListView {
    - controller : PersonController
    + getRoot() : Parent
    + reloadData() : void
    + getSelectedPerson() : Person
}

class PersonFormView {
    - controller : PersonController
    - editingPerson : Person
    + getRoot() : Parent
    + getEditingPerson() : Person
    + getFullNameInput() : String
    + getBirthYearInput() : String
    + getGenderInput() : Gender
    + getPhotoPathInput() : String
    + getSelectedFather() : Person
    + getSelectedMother() : Person
}

class PersonDetailView {
    - controller : PersonController
    - person : Person
    + getRoot() : Parent
}

class FamilyTreeView {
    - controller : PersonController
    - focusPerson : Person
    + getRoot() : Parent
}

' ============================================================
' CONTROLLER
' ============================================================

class PersonController {
    - familyTreeService : FamilyTreeService
    - selectedPerson : Person
    + getAllPersons() : List<Person>
    + handleAdd() : void
    + handleEdit() : void
    + handleDelete() : void
    + handleSearch(keyword : String) : void
    + handleViewDetail() : void
    + handleAssignFather(childId : int, fatherId : int) : void
    + handleAssignMother(childId : int, motherId : int) : void
    + handleClearFather(childId : int) : void
    + handleClearMother(childId : int) : void
    + handleViewTree() : void
    + getSelectedPerson() : Person
    + setSelectedPerson(person : Person) : void
}

' ============================================================
' SERVICE
' ============================================================

class FamilyTreeService {
    - personRepository : PersonRepository
    + getAllPersons() : List<Person>
    + getPersonById(id : int) : Person
    + searchPersons(keyword : String) : List<Person>
    + addPerson(person : Person) : Person
    + updatePerson(person : Person) : void
    + deletePerson(id : int) : void
    + assignFather(childId : int, fatherId : int) : void
    + assignMother(childId : int, motherId : int) : void
    + clearFather(childId : int) : void
    + clearMother(childId : int) : void
    + getAncestors(id : int) : List<Person>
    + getDescendants(id : int) : List<Person>
    - validatePerson(person : Person) : void
    - validateParentAssignment(child : Person, parent : Person, requiredGender : Gender) : void
    - checkCycle(childId : int, candidateParentId : int) : boolean
    - checkPersonInUse(id : int) : boolean
}

' ============================================================
' REPOSITORY
' ============================================================

interface PersonRepository {
    + findAll() : List<Person>
    + findById(id : int) : Person
    + search(keyword : String) : List<Person>
    + save(person : Person) : int
    + update(person : Person) : void
    + delete(id : int) : void
}

class JdbcPersonRepository {
    + findAll() : List<Person>
    + findById(id : int) : Person
    + search(keyword : String) : List<Person>
    + save(person : Person) : int
    + update(person : Person) : void
    + delete(id : int) : void
}

' ============================================================
' DATABASE
' ============================================================

class DatabaseConnection {
    + getConnection() : Connection
    + getConnection(url : String, user : String, password : String) : Connection
}

' ============================================================
' RELATIONSHIPS
' ============================================================

PeopleListView --> PersonController
PersonFormView --> PersonController
PersonDetailView --> PersonController
FamilyTreeView --> PersonController

PersonController --> FamilyTreeService
PersonController --> Person : thành viên đang chọn

FamilyTreeService --> PersonRepository
JdbcPersonRepository ..|> PersonRepository
JdbcPersonRepository --> DatabaseConnection

Person --> "1" Gender
Person "0..*" --> "0..1" Person : cha
Person "0..*" --> "0..1" Person : mẹ

@enduml
