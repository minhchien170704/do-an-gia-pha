@startuml activity-assign-parent

title Activity Diagram - Gán cha/mẹ

start

:Chọn Con;

:Chọn Cha hoặc Mẹ;

:Kiểm tra Cha/Mẹ tồn tại;

if (Cha/Mẹ tồn tại?) then (yes)
else (no)
  :PersonNotFoundException;
  stop
endif

if (Cha/Mẹ == Con?) then (yes)
  :SelfParentException;
  stop
else (no)
endif

if (Đang gán Cha?) then (yes)
  if (Con đã có Mẹ?) then (yes)
    if (fatherId mới == motherId hiện tại?) then (yes)
      :Lỗi: Cha và Mẹ\nkhông được trùng nhau;
      stop
    else (no)
    endif
  else (no)
  endif
else (đang gán Mẹ)
  if (Con đã có Cha?) then (yes)
    if (motherId mới == fatherId hiện tại?) then (yes)
      :Lỗi: Cha và Mẹ\nkhông được trùng nhau;
      stop
    else (no)
    endif
  else (no)
  endif
endif

:Kiểm tra gender theo vai trò;
note right
  Cha phải MALE
  Mẹ phải FEMALE
end note

if (Gender hợp lệ?) then (yes)
else (no)
  :Lỗi: Gender không phù hợp vai trò;
  stop
endif

:Kiểm tra chu trình trong cây gia phả;

if (Phát hiện chu trình?) then (yes)
  :CycleDetectedException;
  stop
else (no)
endif

:Cập nhật quan hệ;
:Repository lưu vào Database;
:Gán cha/mẹ thành công;

stop

@enduml
