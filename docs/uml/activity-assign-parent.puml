@startuml activity-assign-parent

title Activity Diagram - Gán cha/mẹ

start

:Chọn Con;

:Chọn Cha hoặc Mẹ;

:Kiểm tra Cha/Mẹ tồn tại\n(findById);

if (Cha/Mẹ tồn tại?) then (tồn tại)
else (không)
  :PersonNotFoundException;
  :Hiển thị lỗi;
  stop
endif

if (Cha/Mẹ == Con? — BR1) then (trùng)
  :SelfParentException;
  :Hiển thị lỗi;
  stop
else (không)
endif

if (Đang gán Cha?) then (Gán Cha)
  if (Con đã có Mẹ?) then (có)
    if (Cha mới == Mẹ hiện tại? — BR2) then (trùng)
      :SameParentException;
      :Hiển thị lỗi;
      stop
    else (không)
    endif
  else (không)
  endif
else (Gán Mẹ)
  if (Con đã có Cha?) then (có)
    if (Mẹ mới == Cha hiện tại? — BR2) then (trùng)
      :SameParentException;
      :Hiển thị lỗi;
      stop
    else (không)
    endif
  else (không)
  endif
endif

:Kiểm tra giới tính theo vai trò (BR6);
note right
  Cha phải MALE
  Mẹ phải FEMALE
end note

if (Giới tính hợp lệ?) then (hợp lệ)
else (không)
  :InvalidParentGenderException;
  :Hiển thị lỗi;
  stop
endif

:Kiểm tra chu trình trong cây gia phả\n(checkCycle — BR3);

if (Phát hiện chu trình?) then (có)
  :CycleDetectedException;
  :Hiển thị lỗi;
  stop
else (không)
endif

:Cập nhật quan hệ\n(Repository.update());

:Gán cha/mẹ thành công;

stop

@enduml
