@startuml class-diagram-view-controller

title Class Diagram (c) - Gói view + controller

skinparam classAttributeIconSize 0
skinparam classFontSize 12
skinparam class {
    BackgroundColor #FEFECE
    BorderColor #A80036
    ArrowColor #A80036
}
skinparam package {
    BackgroundColor #F5F5FF
    BorderColor #A80036
    FontSize 12
}
skinparam linetype ortho

' ============================================================
' GÓI: com.giapha.controller
' ============================================================
package "com.giapha.controller" {

    interface FormDataSource <<interface>> {
        + getFullNameInput() : String
        + getBirthYearInput() : String
        + getGenderInput() : Gender
        + getSelectedFather() : Person
        + getSelectedMother() : Person
        + getSelectedPhotoSourcePath() : String
        + getExistingPhotoPath() : String
        + getEditingPerson() : Person
    }

    interface PeopleListSource <<interface>> {
        + getSelectedPerson() : Person
        + refresh() : void
    }

    interface Navigator <<interface>> {
        + navigateToPeopleList() : void
        + navigateToPersonDetail(person : Person) : void
        + navigateToFamilyTree(focusPerson : Person) : void
    }

    class PersonController {
        - familyTreeService : FamilyTreeService
        - formDataSource : FormDataSource
        - peopleListSource : PeopleListSource
        - navigator : Navigator
        - selectedPerson : Person
        + PersonController(familyTreeService : FamilyTreeService)
        + handleAdd() : void
        + handleAdd(person : Person) : Person
        + handleEdit() : void
        + handleEdit(personToUpdate : Person, newFather : Person, newMother : Person) : void
        + handleDelete() : void
        + handleDelete(id : int) : void
        + handleSearch(keyword : String) : List<Person>
        + getAllPersons() : List<Person>
        + handleViewDetail() : void
        + handleViewDetail(id : int) : Person
        + handleAssignFather(childId : int, fatherId : int) : void
        + handleAssignMother(childId : int, motherId : int) : void
        + handleClearFather(childId : int) : void
        + handleClearMother(childId : int) : void
        + handleViewTree() : void
        + handleViewTree(focusId : int) : Person
        + setFormDataSource(formDataSource : FormDataSource) : void
        + setPeopleListSource(peopleListSource : PeopleListSource) : void
        + setNavigator(navigator : Navigator) : void
        + setSelectedPerson(selectedPerson : Person) : void
    }
}

' ============================================================
' GÓI: com.giapha.view
' ============================================================
package "com.giapha.view" {

    class PeopleListView {
        - controller : PersonController
        - filteredData : FilteredList<Person>
        + PeopleListView(controller : PersonController)
        + getRoot() : BorderPane
        - reloadData() : void
        + refresh() : void
        + getSelectedPerson() : Person
        + getSearchKeyword() : String
    }

    class PersonFormView {
        - controller : PersonController
        - editingPerson : Person
        - selectedPhotoSourcePath : String
        - selectedPhotoFile : File
        - avatarPreview : PersonAvatar
        + PersonFormView(controller : PersonController)
        + PersonFormView(controller : PersonController, personToEdit : Person)
        + getRoot() : BorderPane
        + getEditingPerson() : Person
        + getFullNameInput() : String
        + getBirthYearInput() : String
        + getGenderInput() : Gender
        + getSelectedFather() : Person
        + getSelectedMother() : Person
        + getSelectedPhotoSourcePath() : String
        + getExistingPhotoPath() : String
    }
    class PersonDetailView {
        - controller : PersonController
        - person : Person
        + PersonDetailView(controller : PersonController, person : Person)
        + getRoot() : BorderPane
    }

    class FamilyTreeView {
        - controller : PersonController
        - diagram : FamilyTreeDiagram
        - cboFocusPerson : ComboBox<Person>
        - treeView : TreeView<TreeNodeItem>
        + FamilyTreeView(controller : PersonController, focusPerson : Person)
        + getRoot() : BorderPane
        - handleExportPng() : void
        - handlePrint() : void
        - buildPrintableNode(job : PrinterJob) : Node
        - confirmPrint(job : PrinterJob) : boolean
        - defaultExportFileName() : String
    }

    class FamilyTreeDiagram {
        - content : Pane
        - allPersons : List<Person>
        - focusPerson : Person
        - onViewPerson : Consumer<Person>
        - zoomProperty : ReadOnlyDoubleWrapper
        + FamilyTreeDiagram()
        + setData(allPersons : List<Person>, focusPerson : Person) : void
        + contentScaleProperty() : ReadOnlyDoubleProperty
        + zoomBy(factor : double) : void
        + resetZoom() : void
        + fitToView() : void
        + renderFullImage() : WritableImage
        + setOnViewPerson(handler : Consumer<Person>) : void
    }

    class PersonAvatar {
        - person : Person
        - size : int
        - imageView : ImageView
        - initialLabel : Label
        + DEFAULT_SIZE : int = 70
        + SMALL_SIZE : int = 34
        + PersonAvatar(person : Person)
        + PersonAvatar(person : Person, size : int)
        + PersonAvatar(person : Person, size : int, imageFile : File)
        + resolveImageFile(photoPath : String) : File
        + isShowingRealImage() : boolean
        + getAvatarSize() : int
    }
}

' ============================================================
' GÓI: com.giapha.util (phụ thuộc từ view/controller)
' ============================================================
package "com.giapha.util" {
    class ImageManager {
        <<utility>>
        + isAllowedImage(filePath : String) : boolean
        + copyImageToAppDirectory(sourceFilePath : String, personId : int) : String
        + deleteImageQuietly(relativePath : String) : void
    }
    class PngWriter {
        <<utility>>
        + write(image : WritableImage, file : File) : void
    }
}

' ============================================================
' QUAN HỆ — VIEW → CONTROLLER
' ============================================================
PeopleListView --> PersonController : gọi xử lý sự kiện
PersonFormView --> PersonController : gọi xử lý sự kiện
PersonDetailView --> PersonController : gọi xử lý sự kiện
FamilyTreeView --> PersonController : gọi xử lý sự kiện

' Controller → Service (điều phối)
PersonController --> FamilyTreeService : gọi nghiệp vụ
note right of PersonController
  Bắt custom exception và ánh xạ
  sang thông báo tiếng Việt (Alert)
end note

' Controller → Abstraction (DIP — không phụ thuộc lớp View concrete)
PersonController --> FormDataSource : đọc dữ liệu form
PersonController --> PeopleListSource : dòng đang chọn + làm mới danh sách
PersonController --> Navigator : yêu cầu chuyển màn hình

' View → Abstraction (adapter hiện thực)
PersonFormView ..|> FormDataSource : hiện thực
PeopleListView ..|> PeopleListSource : hiện thực
note bottom of FormDataSource
  Dữ liệu thuần Java (String/Gender/Person)
  — không truyền JavaFX Control/Node
end note
note bottom of Navigator
  Được nối tại composition root (Main)
  với cơ chế Scene/Stage thật
end note

' View ↔ View
FamilyTreeView *-- FamilyTreeDiagram : chứa (composition)
FamilyTreeDiagram --> PersonAvatar : dựng node
PeopleListView --> PersonAvatar : hiển thị avatar
PersonDetailView --> PersonAvatar : hiển thị avatar
PersonFormView --> PersonAvatar : xem trước ảnh

' Observer: FamilyTreeView lắng nghe zoomProperty của FamilyTreeDiagram
FamilyTreeView --> "zoomProperty" : <<Observer>> đăng ký listener\n(cập nhật nhãn % zoom)

' View/Controller ↔ Util
PersonFormView --> ImageManager : kiểm tra định dạng ảnh
PersonController --> ImageManager : copy ảnh vào images/
FamilyTreeView --> PngWriter : ghi file PNG

@enduml
