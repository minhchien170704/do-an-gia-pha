@startuml component-diagram

title Component Diagram - Sơ đồ gia phả

skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam component {
    BackgroundColor #FEFECE
    BorderColor #A80036
    FontSize 13
}
skinparam interface {
    BackgroundColor #FEFECE
    BorderColor #A80036
    FontSize 13
}
skinparam package {
    BackgroundColor #F5F5FF
    BorderColor #A80036
    FontSize 12
}
skinparam database {
    BackgroundColor #FEFECE
    BorderColor #A80036
    FontSize 12
}
skinparam folder {
    BackgroundColor #FEFECE
    BorderColor #A80036
    FontSize 12
}
skinparam ArrowColor #A80036

package "Tầng Trình Bày" {
    component "JavaFX UI\n(Main, PeopleListView,\nPersonFormView, PersonDetailView,\nFamilyTreeView, FamilyTreeDiagram,\nPersonAvatar)" as UI
    component "PersonController" as Controller
}

package "Tầng Nghiệp Vụ" {
    component "FamilyTreeService" as Service
}

package "Tầng Lưu Trữ" {
    interface "PersonRepository" as RepoInterface
    component "JdbcPersonRepository" as JdbcRepo
    component "DatabaseConnection" as DBConn
}

package "Tiện Ích" {
    component "ImageManager" as ImageMgr
    component "PngWriter" as PngW
}

package "Cơ Sở Dữ Liệu" {
    database "MySQL / MariaDB\n(gia_pha)" as MySQL
}

package "Hệ Thống Tệp" {
    folder "images/\n(ảnh đại diện\nperson_<id>.<đuôi>)" as ImagesDir
}

UI --> Controller : gọi xử lý sự kiện

Controller --> Service : gọi nghiệp vụ

Service --> RepoInterface : sử dụng\n(Dependency Inversion)

JdbcRepo ..|> RepoInterface : implements\n(Repository Pattern)

JdbcRepo --> DBConn : lấy Connection

DBConn --> MySQL : JDBC Connection\n(static factory)

Controller --> ImageMgr : copy ảnh vào images/
UI --> ImageMgr : kiểm tra định dạng

UI --> PngW : ghi file PNG

ImageMgr --> ImagesDir : copy / dọn file ảnh

@enduml
