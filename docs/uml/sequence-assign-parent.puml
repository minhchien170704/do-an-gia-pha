@startuml sequence-assign-parent

title Sequence Diagram - Gán cha/mẹ

actor "Người dùng" as User
participant "PersonController" as Controller
participant "FamilyTreeService" as Service
participant "PersonRepository" as Repo
participant "JdbcPersonRepository" as JdbcRepo
participant "DatabaseConnection" as DBConn
database "MySQL" as DB

User -> Controller : handleAssignFather() hoặc handleAssignMother()

alt Gán Cha
    Controller -> Service : assignFather(childId, fatherId)
else Gán Mẹ
    Controller -> Service : assignMother(childId, motherId)
end

Service -> Repo : findById(childId)
Repo -> JdbcRepo : findById(childId)
JdbcRepo -> DBConn : getConnection()
DBConn --> JdbcRepo : Connection
JdbcRepo -> DB : SELECT * FROM person WHERE id = childId
DB --> JdbcRepo : dòng dữ liệu
JdbcRepo --> Repo : Person (con)
Repo --> Service : Person (con)

Service -> Repo : findById(parentId)
Repo -> JdbcRepo : findById(parentId)
JdbcRepo -> DBConn : getConnection()
DBConn --> JdbcRepo : Connection
JdbcRepo -> DB : SELECT * FROM person WHERE id = parentId
DB --> JdbcRepo : dòng dữ liệu
JdbcRepo --> Repo : Person (cha/mẹ)
Repo --> Service : Person (cha/mẹ)

Service -> Service : validateParentAssignment(child, parent, requiredGender)

alt 1. Cha/Mẹ không tồn tại (null)
    Service --> Controller : PersonNotFoundException
    Controller --> User : hiển thị lỗi

else 2. child.id == parent.id (tự làm cha/mẹ)
    Service --> Controller : SelfParentException
    Controller --> User : hiển thị lỗi

else 3. Kiểm tra Cha != Mẹ (theo vai trò đang gán)

    alt Đang gán Cha (assignFather)
        alt child.mother != null VÀ fatherId == child.mother.id
            Service --> Controller : validation error (trùng vai trò)
            Controller --> User : hiển thị lỗi
        end
    else Đang gán Mẹ (assignMother)
        alt child.father != null VÀ motherId == child.father.id
            Service --> Controller : validation error (trùng vai trò)
            Controller --> User : hiển thị lỗi
        end
    end

    alt 4. Gender không phù hợp vai trò
        Service --> Controller : validation error (gender không phù hợp vai trò)
        Controller --> User : hiển thị lỗi

    else Gender hợp lệ
        Service -> Service : checkCycle(childId, candidateParentId)

        alt 5. Phát hiện chu trình
            Service --> Controller : CycleDetectedException
            Controller --> User : hiển thị lỗi

        else 6. Không có chu trình
            Service -> Repo : update(child)
            Repo -> JdbcRepo : update(child)
            JdbcRepo -> DBConn : getConnection()
            DBConn --> JdbcRepo : Connection
            JdbcRepo -> DB : UPDATE person SET father_id/mother_id WHERE id = childId
            DB --> JdbcRepo : thành công
            JdbcRepo --> Repo : void
            Repo --> Service : void
            Service --> Controller : void
            Controller --> User : Gán cha/mẹ thành công
        end
    end
end

@enduml
