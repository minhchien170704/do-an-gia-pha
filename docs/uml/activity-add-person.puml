@startuml activity-add-person

title Activity Diagram - Thêm người

start

:Người dùng nhập thông tin người;
note right
  fullName, birthYear,
  gender
end note

:Chọn Cha / Mẹ\n(có thể bỏ trống);

:Kiểm tra thông tin cơ bản\n(validatePerson);

if (Thông tin hợp lệ?) then (hợp lệ)
else (không hợp lệ)
  :IllegalArgumentException\nhoặc InvalidBirthYearException;
  :Hiển thị lỗi;
  stop
endif

if (Cả Cha và Mẹ đều được chọn?) then (có)
  if (Cha == Mẹ? — BR2) then (trùng)
    :SameParentException;
    :Hiển thị lỗi;
    stop
  else (không)
  endif
else (không)
endif

if (Cha được chọn?) then (có)
  :Kiểm tra Cha tồn tại;
  if (Cha tồn tại?) then (có)
    if (Cha.gender == MALE? — BR6) then (đúng)
    else (sai)
      :InvalidParentGenderException;
      :Hiển thị lỗi;
      stop
    endif
  else (không)
    :PersonNotFoundException;
    :Hiển thị lỗi;
    stop
  endif
else (không)
endif

if (Mẹ được chọn?) then (có)
  :Kiểm tra Mẹ tồn tại;
  if (Mẹ tồn tại?) then (có)
    if (Mẹ.gender == FEMALE? — BR6) then (đúng)
    else (sai)
      :InvalidParentGenderException;
      :Hiển thị lỗi;
      stop
    endif
  else (không)
    :PersonNotFoundException;
    :Hiển thị lỗi;
    stop
  endif
else (không)
endif

:checkBirthYearWarning()\n(kiểm tra BR5);

if (Có cảnh báo năm sinh?) then (có)
  :Hiển thị Alert cảnh báo\n(Tiếp tục / Hủy);
  if (Người dùng chọn?) then (Hủy)
    :Dừng, không lưu;
    stop
  else (Tiếp tục)
  endif
else (không)
endif

:Lưu Person vào Database\n(Repository.save());

if (Người dùng đã chọn ảnh đại diện?) then (có)
  :Copy ảnh vào images/person_<id>.<đuôi>\n(ImageManager);
  :Lưu đường dẫn tương đối vào photo_path\n(Repository.update());
else (không)
endif

:Thêm người thành công;

stop

@enduml
