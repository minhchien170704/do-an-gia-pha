@startuml activity-add-person

title Activity Diagram - Thêm người

start

:Người dùng nhập thông tin người;
note right
  fullName, birthYear,
  gender, photoPath
end note

:Chọn Cha / Mẹ\n(có thể bỏ trống);

:Kiểm tra thông tin cơ bản;

if (Thông tin hợp lệ?) then (yes)
else (no)
  :Hiển thị lỗi validation;
  stop
endif

if (Cha được chọn?) then (yes)
  :Kiểm tra Cha tồn tại;
  if (Cha tồn tại?) then (yes)
  else (no)
    :PersonNotFoundException;
    stop
  endif
else (no)
endif

if (Mẹ được chọn?) then (yes)
  :Kiểm tra Mẹ tồn tại;
  if (Mẹ tồn tại?) then (yes)
  else (no)
    :PersonNotFoundException;
    stop
  endif
else (no)
endif

if (Cả Cha và Mẹ đều được chọn?) then (yes)
  if (Cha == Mẹ?) then (yes)
    :Lỗi: Cha và Mẹ\nkhông được trùng nhau;
    stop
  else (no)
  endif
else (no)
endif

if (Cha được chọn?) then (yes)
  if (Cha.gender == MALE?) then (yes)
  else (no)
    :Lỗi: Cha phải có gender MALE;
    stop
  endif
else (no)
endif

if (Mẹ được chọn?) then (yes)
  if (Mẹ.gender == FEMALE?) then (yes)
  else (no)
    :Lỗi: Mẹ phải có gender FEMALE;
    stop
  endif
else (no)
endif

:Lưu Person;
:Repository lưu vào Database;
:Thêm người thành công;

stop

@enduml
