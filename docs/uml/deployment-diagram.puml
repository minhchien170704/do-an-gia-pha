@startuml deployment-diagram

title Deployment Diagram - Sơ đồ gia phả

skinparam backgroundColor #FFFFFF
skinparam node {
    BackgroundColor #F8F9FA
    BorderColor #A80036
    FontSize 13
}
skinparam component {
    BackgroundColor #FEFECE
    BorderColor #A80036
    FontSize 12
}
skinparam database {
    BackgroundColor #FEFECE
    BorderColor #A80036
    FontSize 12
}
skinparam ArrowColor #A80036

node "Máy tính người dùng" as Client {
    node "Môi trường chạy Java\n(Java 25)" as JRE {
        component "Ứng dụng JavaFX\n(Quản lý Gia phả)" as App
        component "Driver MySQL JDBC\n(Connector/J)" as Driver
    }
}

node "Máy chủ MySQL" as Server {
    node "Máy chủ Cơ sở dữ liệu MySQL" as DBMS {
        database "Cơ sở dữ liệu: gia_pha" as DB {
            [Bảng PERSON]
        }
    }
}

App ..> Driver : sử dụng
Driver --> DB : JDBC Connection (TCP/IP Port 3306)

@enduml
